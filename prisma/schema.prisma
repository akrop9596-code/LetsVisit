generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("TOURIST")
  profileImage String?  @map("profile_image")
  phone        String?
  bio          String?
  preferences  String   @default("[]")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  properties Property[]
  reviews    Review[]
  favorites  Favorite[]
  trips      Trip[]
  reports    Report[]

  @@map("users")
}

model Place {
  id                String   @id @default(cuid())
  name              String
  category          String
  description       String
  shortDescription  String?  @map("short_description")
  address           String
  city              String
  state             String
  country           String   @default("India")
  latitude          Float
  longitude         Float
  openingTime       String?  @map("opening_time")
  closingTime       String?  @map("closing_time")
  entryFee          Float?   @map("entry_fee")
  estimatedDuration String?  @map("estimated_duration")
  bestTimeToVisit   String?  @map("best_time_to_visit")
  ratingAvg         Float    @default(0) @map("rating_avg")
  reviewCount       Int      @default(0) @map("review_count")
  isFeatured        Boolean  @default(false) @map("is_featured")
  tags              String   @default("[]")
  website           String?
  phone             String?
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  images     PlaceImage[]
  reviews    Review[]
  favorites  Favorite[]
  tripPlaces TripPlace[]

  @@index([city])
  @@index([category])
  @@index([ratingAvg])
  @@index([latitude, longitude])
  @@map("places")
}

model PlaceImage {
  id       String @id @default(cuid())
  placeId  String @map("place_id")
  imageUrl String @map("image_url")
  caption  String?
  order    Int    @default(0)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@map("place_images")
}

model Property {
  id                 String   @id @default(cuid())
  ownerId            String   @map("owner_id")
  title              String
  description        String
  propertyType       String   @map("property_type")
  address            String
  city               String
  state              String
  country            String   @default("India")
  latitude           Float
  longitude          Float
  pricePerNight      Float    @map("price_per_night")
  maxGuests          Int      @map("max_guests")
  bedrooms           Int      @default(1)
  beds               Int      @default(1)
  bathrooms          Int      @default(1)
  houseRules         String?  @map("house_rules")
  verificationStatus String   @default("PENDING") @map("verification_status")
  isActive           Boolean  @default(true) @map("is_active")
  ratingAvg          Float    @default(0) @map("rating_avg")
  reviewCount        Int      @default(0) @map("review_count")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images    PropertyImage[]
  amenities PropertyAmenity[]
  reviews   Review[]
  favorites Favorite[]

  @@index([city])
  @@index([propertyType])
  @@index([pricePerNight])
  @@index([verificationStatus])
  @@index([latitude, longitude])
  @@map("properties")
}

model PropertyImage {
  id         String @id @default(cuid())
  propertyId String @map("property_id")
  imageUrl   String @map("image_url")
  caption    String?
  order      Int    @default(0)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_images")
}

model Amenity {
  id   String @id @default(cuid())
  name String @unique
  icon String?

  properties PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  propertyId String @map("property_id")
  amenityId  String @map("amenity_id")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@map("property_amenities")
}

model Review {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  placeId    String?   @map("place_id")
  propertyId String?   @map("property_id")
  rating     Int
  reviewText String?   @map("review_text")
  visitDate  DateTime? @map("visit_date")
  photos     String    @default("[]")
  isApproved Boolean   @default(true) @map("is_approved")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  place    Place?    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@unique([userId, propertyId])
  @@map("reviews")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  placeId    String?  @map("place_id")
  propertyId String?  @map("property_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  place    Place?    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@unique([userId, propertyId])
  @@map("favorites")
}

model Trip {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  name        String
  destination String
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  places TripPlace[]

  @@map("trips")
}

model TripPlace {
  id            String @id @default(cuid())
  tripId        String @map("trip_id")
  placeId       String @map("place_id")
  dayNumber     Int    @map("day_number")
  sequenceOrder Int    @map("sequence_order")
  notes         String?

  trip  Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([tripId, placeId])
  @@map("trip_places")
}

model Report {
  id         String   @id @default(cuid())
  reporterId String   @map("reporter_id")
  placeId    String?  @map("place_id")
  propertyId String?  @map("property_id")
  reason     String
  details    String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}
